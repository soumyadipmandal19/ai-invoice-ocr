# Copy to .env.local and replace placeholders.

# Python and OCR
PYTHON_EXECUTABLE=.venv/bin/python
TESSDATA_PREFIX=/path/to/tesseract/tessdata

# Inngest local development (set to 0 in production)
INNGEST_DEV=1

# Inngest production only
# INNGEST_EVENT_KEY=your-inngest-event-key
# INNGEST_SIGNING_KEY=your-inngest-signing-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=provider/model-id
OPENROUTER_APP_NAME="Your App Name"
OPENROUTER_APP_URL=http://localhost:3000

# Neo4j
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-database-username
NEO4J_PASSWORD="your-database-password"
NEO4J_DATABASE=your-database-name

# Optional overrides
# CLASSIFICATION_STORE_DIR=/path/to/classification-results
# AUTH_ORIGIN=https://your-app-domain.com
